erDiagram
    USERS ||--o{ RATINGS : submits
    MOVIES ||--o{ RATINGS : gets
    MOVIES ||--o{ MOVIE_GENRES : has
    GENRES ||--o{ MOVIE_GENRES : tags

    USERS {
        integer user_id PK
        varchar display_name
        varchar email UK
        timestamp joined_at
    }
    MOVIES {
        integer movie_id PK
        varchar title
        integer release_year
        integer runtime_minutes
        boolean is_active
    }
    RATINGS {
        integer rating_id PK
        integer user_id FK
        integer movie_id FK
        timestamp rated_at
        numeric score
    }
    GENRES {
        integer genre_id PK
        varchar name UK
    }
    MOVIE_GENRES {
        integer movie_id PK, FK
        integer genre_id PK, FK
    }
